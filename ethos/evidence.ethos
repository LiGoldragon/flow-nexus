  ExitWitness.{ CapsuleHandle ExitProvenance } ; exit witness
  CreationIntent.{ CreationLocator AttemptedAction } ; creation intent
  AdmittedRequest.{ RequestId Address ArrivalOrder.Integer Request } ; admitted request
