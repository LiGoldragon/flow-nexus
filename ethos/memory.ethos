Memory
[ :crate:[ Address FlowId SessionId State TranscriptPath ]
  :crate:evidence:[ RequestId ProcessIncarnation ResolvedLaunch ResourceEvidence CreationIntent LaunchPhase EndPhase AdmittedRequest ] ] ; imports: record fields, defined once
[ ProcessBinding.{ FlowId ProcessIncarnation } ; process binding
  LaunchAttempt.{ RequestId FlowId Address ResolvedLaunch ResourceEvidence CreationIntent LaunchPhase } ; launch attempt
  EndAttempt.{ RequestId FlowId EndPhase } ; end attempt
  Permaflow.{ Address Vector<FlowId> } ; permaflow
  Flow.{ FlowId Address Option<SessionId> State Option<FlowId> Option<TranscriptPath> } ; flow
  Queue.{ Address Vector<AdmittedRequest> } ] ; records: exactly the durable row types
