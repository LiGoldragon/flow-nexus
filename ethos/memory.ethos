Memory
[ :crate:[ Address FlowId SessionId State TranscriptPath Configuration ]
  :crate:evidence:[ RequestId OriginAdmissionId ProcessIncarnation ResolvedLaunch ResourceEvidence CreationIntent LaunchPhase EndPhase AdmittedRequest VerificationTarget VerificationState MetaConfigureOccurred ArrivalOrdinal ContentFingerprint HostBootIdentity PidNamespaceIdentity ] ] ; imports: record fields and evidence
[ ConfigurationRecord.{ Configuration MetaConfigureOccurred } ; configuration metadata
  AddressReservation.{ Address FlowId RequestId }                       ; address reservation
  ProcessBinding.{ FlowId ProcessIncarnation }                          ; process binding
  LaunchAttempt.{ RequestId FlowId Address Option<OriginAdmissionId> ResolvedLaunch ResourceEvidence CreationIntent LaunchPhase } ; launch attempt
  EndAttempt.{ RequestId FlowId EndPhase }                               ; end attempt
  Permaflow.{ Address Vector<FlowId> }                                   ; permaflow
  Flow.{ FlowId Address Option<SessionId> State Option<FlowId> Option<TranscriptPath> } ; flow
  Queue.{ Address Vector<AdmittedRequest> }                              ; queue
  Verification.{ VerificationTarget ContentFingerprint HostBootIdentity PidNamespaceIdentity VerificationState }                  ; verification
  RequestAllocator.{ RequestId }                                         ; private request allocator
  ArrivalAllocator.{ Address ArrivalOrdinal } ]                          ; per-address allocator
